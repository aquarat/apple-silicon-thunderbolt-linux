From a9aa04ecf1b5ea6811c8accad7c3f87380c65347 Mon Sep 17 00:00:00 2001
From: aquarat <3090997+aquarat@users.noreply.github.com>
Date: Tue, 20 Oct 2026 07:57:30 +0000
Subject: [PATCH 4/4] arm64: dts: apple: t600x-j314-j316, t600x-j375: Enable
 tunnelled PCIe

Enable the tunnelled PCIe controllers of the USB4 ports (0-2 on the
MacBook Pros, 0-3 on the Mac Studio) and add the usb4_N_pcie aliases the
bootloader uses to fill in their tunables.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: aquarat <3090997+aquarat@users.noreply.github.com>
---
 .../arm64/boot/dts/apple/t600x-j314-j316.dtsi | 28 ++++++++++++++
 arch/arm64/boot/dts/apple/t600x-j375.dtsi     | 37 +++++++++++++++++++
 2 files changed, 65 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi b/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
index 028f44690..4c5ff9b9a 100644
--- a/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
+++ b/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
@@ -41,6 +41,9 @@ aliases {
 		usb4_1_nhi = &usb4_1_nhi;
 		usb4_2_rc = &usb4_2_acio;
 		usb4_2_nhi = &usb4_2_nhi;
+		usb4_0_pcie = &apciec0;
+		usb4_1_pcie = &apciec1;
+		usb4_2_pcie = &apciec2;
 	};
 
 	chosen {
@@ -673,6 +676,31 @@ typec2_con_tbt: endpoint {
 	};
 };
 
+/* Tunnelled PCIe (USB4) */
+&apciec0_dart {
+	status = "okay";
+};
+
+&apciec0 {
+	status = "okay";
+};
+
+&apciec1_dart {
+	status = "okay";
+};
+
+&apciec1 {
+	status = "okay";
+};
+
+&apciec2_dart {
+	status = "okay";
+};
+
+&apciec2 {
+	status = "okay";
+};
+
 /* USB4 */
 &usb4_0_acio {
 	ports {
diff --git a/arch/arm64/boot/dts/apple/t600x-j375.dtsi b/arch/arm64/boot/dts/apple/t600x-j375.dtsi
index 2cdd2e2fb..45bb06091 100644
--- a/arch/arm64/boot/dts/apple/t600x-j375.dtsi
+++ b/arch/arm64/boot/dts/apple/t600x-j375.dtsi
@@ -45,6 +45,10 @@ aliases {
 		usb4_2_nhi = &usb4_2_nhi;
 		usb4_3_rc = &usb4_3_acio;
 		usb4_3_nhi = &usb4_3_nhi;
+		usb4_0_pcie = &apciec0;
+		usb4_1_pcie = &apciec1;
+		usb4_2_pcie = &apciec2;
+		usb4_3_pcie = &apciec3;
 	};
 
 	chosen {
@@ -547,6 +551,39 @@ typec3_con_tbt: endpoint {
 	};
 };
 
+/* Tunnelled PCIe (USB4) */
+&apciec0_dart {
+	status = "okay";
+};
+
+&apciec0 {
+	status = "okay";
+};
+
+&apciec1_dart {
+	status = "okay";
+};
+
+&apciec1 {
+	status = "okay";
+};
+
+&apciec2_dart {
+	status = "okay";
+};
+
+&apciec2 {
+	status = "okay";
+};
+
+&apciec3_dart {
+	status = "okay";
+};
+
+&apciec3 {
+	status = "okay";
+};
+
 /* USB4 */
 &usb4_0_acio {
 	ports {
