From 71088c83a9f658891dd3a9186c75bee81115dc3e Mon Sep 17 00:00:00 2001
From: jshay21 <5350197+jshay21@users.noreply.github.com>
Date: Fri, 27 Nov 2026 23:59:53 +0000
Subject: [PATCH 6/6] arm64: dts: apple: t8103-j274: Enable tunnelled PCIe

Enable the tunnelled PCIe controllers of both USB4 ports of the M1 Mac mini
and add the usb4_N_pcie aliases the bootloader uses to fill in their
tunables. Tested on port 1 with a Thunderbolt 3 10GbE adapter (JHL7440,
AQC113): 9.4 Gbit/s both ways. The other T8103 boards are untested.

Assisted-by: Claude:claude-fable-5-2
Signed-off-by: aquarat <3090997+aquarat@users.noreply.github.com>
---
 .../boot/dts/apple/t8103-j274-apciec.dtsi     | 30 +++++++++++++++++++
 arch/arm64/boot/dts/apple/t8103-j274.dts      |  2 ++
 2 files changed, 32 insertions(+)
 create mode 100644 arch/arm64/boot/dts/apple/t8103-j274-apciec.dtsi

diff --git a/arch/arm64/boot/dts/apple/t8103-j274-apciec.dtsi b/arch/arm64/boot/dts/apple/t8103-j274-apciec.dtsi
new file mode 100644
index 000000000000..7883656e60bb
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8103-j274-apciec.dtsi
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Board part for the M1 Mac mini (j274): USB4 ports 0-1. Included from
+ * t8103-j274.dts. The other T8103 boards are untested and get no board part
+ * yet.
+ */
+
+/ {
+	aliases {
+		/* used by m1n1 to fill the APCIEC tunables */
+		usb4_0_pcie = &apciec0;
+		usb4_1_pcie = &apciec1;
+	};
+};
+
+&apciec0_dart {
+	status = "okay";
+};
+
+&apciec0 {
+	status = "okay";
+};
+
+&apciec1_dart {
+	status = "okay";
+};
+
+&apciec1 {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/apple/t8103-j274.dts b/arch/arm64/boot/dts/apple/t8103-j274.dts
index 2d491408f32c..dfc28a75c684 100644
--- a/arch/arm64/boot/dts/apple/t8103-j274.dts
+++ b/arch/arm64/boot/dts/apple/t8103-j274.dts
@@ -147,3 +147,5 @@ &gpu {
 };
 
 #include "hwmon-mini.dtsi"
+
+#include "t8103-j274-apciec.dtsi"
-- 
2.56.0

