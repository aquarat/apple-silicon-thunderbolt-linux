From 29559001a0674df931c821ba516d7744cb0538a7 Mon Sep 17 00:00:00 2001
From: aquarat <3090997+aquarat@users.noreply.github.com>
Date: Tue, 20 Oct 2026 20:57:23 +0000
Subject: [PATCH] thunderbolt: apple: Derive a per-machine host router UID

The host router UID comes from the DROM that the bootloader copies from
the Apple device tree into "apple,thunderbolt-drom". m1n1 copies it
verbatim, and the Apple device tree carries a placeholder UID that is the
same on every machine of a family (on some ports it is just the port
index). Two such Macs connected through the same port index then
announce the same XDomain UUID: the connection is treated as a loop,
lane bonding is skipped and thunderbolt-net generates the same MAC
address on both ends, which also breaks bridging several Macs together.

Take the UIDs as real only when all host routers of the machine share
the same non-zero upper bits, the layout a per-machine value with the
port index in the low byte would have; the placeholders do not. Otherwise
derive the UID from a salted SHA-256 of the machine serial number, so the
serial itself is not exposed, and keep the port index in the low byte so
the host routers of one machine stay distinct. The fixup runs before the
cable information is written, i.e. before the link comes up and an
XDomain connection can see the UUID.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: aquarat <3090997+aquarat@users.noreply.github.com>
---
 drivers/thunderbolt/Kconfig |   1 +
 drivers/thunderbolt/apple.c | 107 ++++++++++++++++++++++++++++++++++++
 2 files changed, 108 insertions(+)

diff --git a/drivers/thunderbolt/Kconfig b/drivers/thunderbolt/Kconfig
index d9fbe3a0d..022bb692f 100644
--- a/drivers/thunderbolt/Kconfig
+++ b/drivers/thunderbolt/Kconfig
@@ -81,6 +81,7 @@ config USB4_APPLE_SOC
 	depends on OF && APPLE_RTKIT
 	depends on TYPEC
 	select APPLE_TUNABLE
+	select CRYPTO_LIB_SHA256
 	help
 	  Say Y here to add support for the USB4 and Thunderbolt host
 	  routers found on Apple Silicon machines starting with the M1.
diff --git a/drivers/thunderbolt/apple.c b/drivers/thunderbolt/apple.c
index 1e6d2e583..229c3ea16 100644
--- a/drivers/thunderbolt/apple.c
+++ b/drivers/thunderbolt/apple.c
@@ -77,6 +77,7 @@
  * and trigger some internal watchdog that will reset the entire SoC at worst.
  */
 
+#include <crypto/sha2.h>
 #include <linux/bitfield.h>
 #include <linux/completion.h>
 #include <linux/interrupt.h>
@@ -89,10 +90,12 @@
 #include <linux/platform_device.h>
 #include <linux/pm_domain.h>
 #include <linux/reset.h>
+#include <linux/slab.h>
 #include <linux/soc/apple/rtkit.h>
 #include <linux/soc/apple/tunable.h>
 #include <linux/spinlock.h>
 #include <linux/types.h>
+#include <linux/unaligned.h>
 #include <linux/usb/pd.h>
 #include <linux/usb/typec_mux.h>
 #include <linux/usb/typec_tbt.h>
@@ -223,6 +226,108 @@ struct apple_nhi {
 
 #define nhi_to_anhi(nhi_) container_of((nhi_), struct apple_nhi, nhi)
 
+/*
+ * The host router UID comes from the DROM in the device tree. The bootloader
+ * copies that DROM from the Apple device tree, where it carries a placeholder
+ * UID that is the same on every machine of a family (and is just the port
+ * index on some ports). The placeholders of one machine differ in their upper
+ * bits, so the UIDs are only taken as real when all host routers share the
+ * same non-zero upper bits: the layout of a per-machine value with the port
+ * index in the low byte.
+ */
+#define APPLE_NHI_DROM_UID_OFFSET 1
+#define APPLE_NHI_UID_PORT_MASK GENMASK_ULL(7, 0)
+
+static const char apple_nhi_uid_salt[] = "linux-thunderbolt-apple-host-router-uid";
+
+static int apple_nhi_drom_uid(const struct device_node *np, u64 *uid)
+{
+	u8 hdr[APPLE_NHI_DROM_UID_OFFSET + sizeof(*uid)];
+	int ret;
+
+	ret = of_property_read_u8_array(np, "apple,thunderbolt-drom", hdr, sizeof(hdr));
+	if (ret)
+		return ret;
+
+	*uid = get_unaligned_le64(&hdr[APPLE_NHI_DROM_UID_OFFSET]);
+	return 0;
+}
+
+static bool apple_nhi_uid_is_personalized(void)
+{
+	struct device_node *np;
+	u64 uid, upper = 0;
+	unsigned int n = 0;
+
+	for_each_compatible_node(np, NULL, "apple,t8103-usb4-nhi") {
+		if (apple_nhi_drom_uid(np, &uid))
+			continue;
+
+		uid &= ~APPLE_NHI_UID_PORT_MASK;
+		if (n++ && uid != upper) {
+			of_node_put(np);
+			return false;
+		}
+		upper = uid;
+	}
+
+	/* Nothing to compare against with a single host router: trust it */
+	return n < 2 || upper;
+}
+
+/**
+ * apple_nhi_fixup_host_uid - Give the host router a per-machine UID
+ * @anhi: NHI whose domain has just been added
+ *
+ * If the bootloader left the placeholder UIDs in the host DROMs, two machines
+ * of the same family announce the same XDomain UUID on the same port and
+ * thunderbolt-net derives the same MAC address on both ends. Replace the UID
+ * with one derived from the machine serial number, keeping the port index in
+ * the low byte so that the host routers of one machine stay distinct.
+ *
+ * Must be called with the domain lock held, before the link is brought up and
+ * any XDomain connection can use the UUID.
+ */
+static void apple_nhi_fixup_host_uid(struct apple_nhi *anhi)
+{
+	struct tb_switch *sw = anhi->tb->root_switch;
+	u8 digest[SHA256_DIGEST_SIZE];
+	const char *serial;
+	u32 uuid[4];
+	char *seed;
+	u64 uid;
+
+	lockdep_assert_held(&anhi->tb->lock);
+
+	if (!sw->uuid || apple_nhi_uid_is_personalized())
+		return;
+
+	if (of_property_read_string(of_root, "serial-number", &serial) || !*serial) {
+		dev_warn(anhi->dev, "no serial number, keeping placeholder host router UID\n");
+		return;
+	}
+
+	seed = kasprintf(GFP_KERNEL, "%s:%s", apple_nhi_uid_salt, serial);
+	if (!seed)
+		return;
+	sha256((const u8 *)seed, strlen(seed), digest);
+	kfree(seed);
+
+	uid = get_unaligned_le64(digest) & ~APPLE_NHI_UID_PORT_MASK;
+	uid |= sw->uid & APPLE_NHI_UID_PORT_MASK;
+
+	dev_info(anhi->dev, "placeholder host router UID %#llx, using %#llx\n", sw->uid, uid);
+
+	/* Same layout as tb_switch_set_uuid() */
+	uuid[0] = lower_32_bits(uid);
+	uuid[1] = upper_32_bits(uid);
+	uuid[2] = 0xffffffff;
+	uuid[3] = 0xffffffff;
+
+	sw->uid = uid;
+	memcpy(sw->uuid, uuid, sizeof(uuid));
+}
+
 /**
  * apple_cio_rtkit_shmem_setup - Map an RTKit shared memory buffer
  * @cookie: ACIO instance passed to RTKit
@@ -583,6 +688,8 @@ static int apple_nhi_probe(struct platform_device *pdev)
 		goto err_unlock_tb_domain;
 	}
 
+	apple_nhi_fixup_host_uid(anhi);
+
 	cap_apple = tb_switch_find_vse_cap(anhi->tb->root_switch, TB_VSE_CAP_APPLE);
 
 	if (cap_apple < 0) {
-- 
2.56.0

